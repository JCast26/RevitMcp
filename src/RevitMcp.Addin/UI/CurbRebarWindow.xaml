<Window x:Class="RevitMcp.Addin.UI.CurbRebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM Suite - Armado de Sardineles y Muretes"
        Height="730" Width="540" MinWidth="510"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F1F5F9"
        FontFamily="Segoe UI"
        FontSize="12"
        Foreground="#1E293B">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera BIM Suite con icono propio -->
        <Border Grid.Row="0" Background="#0284C7" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" Background="#0369A1" CornerRadius="6" Margin="0,0,12,0">
                    <TextBlock Text="🧱" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="BIM Suite - Armado de Sardineles y Muretes" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Modelado paramétrico de estribos y armadura longitudinal de confinamiento" FontSize="11" Foreground="#E0F2FE"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido desplazable -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,10,14,0">
            <StackPanel>

                <!-- 1. Selección de Sardineles -->
                <GroupBox Header="1. Selección de Sardinel(es) Anfitrión(es)">
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="lblSelectionCount" Text="0 sardinel(es) seleccionado(s)" FontWeight="SemiBold" Foreground="#0284C7" FontSize="12.5"/>
                            <TextBlock x:Name="lblSelectionDims" Text="Seleccione uno o varios muros de sardinel en Revit." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button x:Name="btnPickWalls" Grid.Column="1" Content="Seleccionar en Revit" Padding="14,5" Height="28" 
                                Background="#F8FAFC" BorderBrush="#CBD5E1" Click="BtnPickWalls_Click"/>
                    </Grid>
                </GroupBox>

                <!-- 2. Esquema Interactivo de Sección Transversal -->
                <GroupBox Header="2. Esquema Interactivo de Sección Transversal">
                    <StackPanel>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,6">
                            <Viewbox Height="160" HorizontalAlignment="Center">
                                <Canvas x:Name="cvsSection" Width="260" Height="170" Background="#F8FAFC" ClipToBounds="True">
                                    <!-- Contorno del Sardinel de Concreto -->
                                    <Rectangle x:Name="rectCurb" Canvas.Left="102" Canvas.Top="12" Width="56" Height="146" 
                                               Fill="#EFECE6" Stroke="#64748B" StrokeThickness="1.5" RadiusX="2" RadiusY="2"/>

                                    <!-- CAPA: Estribo (Dibujado dinámicamente) -->
                                    <Canvas x:Name="vizStirrupLayer"/>

                                    <!-- CAPA: Barras Longitudinales (Dibujadas dinámicamente) -->
                                    <Canvas x:Name="vizLongitudinalLayer"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- Leyenda -->
                        <WrapPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Rectangle Width="14" Height="4" Fill="#D946EF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Estribo transversal" FontSize="10.5" Foreground="#A21CAF" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="#0284C7" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Barras longitudinales (N° Fijo)" FontSize="10.5" Foreground="#0284C7" FontWeight="SemiBold"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 3. Configuración de Estribos Transversales -->
                <GroupBox Header="3. Estribos Transversales">
                    <StackPanel>
                        <!-- Selector Tipo de Estribo -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <RadioButton x:Name="rbOpenC" Content="Estribo Abierto en &quot;C&quot; (Ganchos a 180° - Muros delgados)" 
                                             IsChecked="True" FontWeight="SemiBold" Foreground="#0369A1" Margin="0,0,0,6"
                                             Checked="StirrupType_Changed"/>
                                <RadioButton x:Name="rbClosedRect" Content="Estribo Cerrado Rectangular (Ganchos a 135° - Muros anchos)" 
                                             FontWeight="SemiBold" Foreground="#334155"
                                             Checked="StirrupType_Changed"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Content="Barra estribo:"/>
                            <ComboBox x:Name="cbStirrupBar" Grid.Column="1" Margin="0,0,10,0" SelectionChanged="Options_Changed"/>

                            <Label Grid.Column="2" Content="Espacio (cm):"/>
                            <TextBox x:Name="txtStirrupSpacing" Grid.Column="3" Text="20" HorizontalContentAlignment="Center" 
                                     ToolTip="Separación entre estribos en centímetros" TextChanged="Options_TextChanged"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 4. Refuerzo Longitudinal (Regla: Número Fijo) -->
                <GroupBox Header="4. Refuerzo Longitudinal (Regla de Número Fijo)">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Disposición:"/>
                        <ComboBox x:Name="cbLongitudinalCount" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="Options_Changed"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Barra:"/>
                        <ComboBox x:Name="cbLongitudinalBar" Grid.Row="1" Grid.Column="1" SelectionChanged="Options_Changed"/>
                    </Grid>
                </GroupBox>

                <!-- 5. Encuentros en Esquina (L / T) -->
                <GroupBox Header="5. Encuentros en Esquina (L / T)">
                    <StackPanel>
                        <CheckBox x:Name="chkExtendAtCorners" 
                                  Content="Doblar barras longitudinales en sardineles contiguos (Encuentros L / T)"
                                  IsChecked="True" FontWeight="SemiBold" Foreground="#0284C7" Margin="0,0,0,8"
                                  Checked="ChkExtendAtCorners_Changed" Unchecked="ChkExtendAtCorners_Changed"/>

                        <Grid x:Name="gridCornerHook" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Gancho en encuentro:"/>
                            <ComboBox x:Name="cbCornerHook" Grid.Column="1" SelectionChanged="Options_Changed"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 6. Recubrimiento de Concreto -->
                <GroupBox Header="6. Recubrimiento de Concreto">
                    <StackPanel>
                        <CheckBox x:Name="chkUseWallCover" Content="Obtener recubrimiento asignado al muro anfitrión en Revit"
                                  IsChecked="True" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"
                                  Checked="ChkUseWallCover_Changed" Unchecked="ChkUseWallCover_Changed"/>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Recubrimiento manual (cm):"/>
                            <TextBox x:Name="txtCover" Grid.Column="1" Text="2.5" HorizontalContentAlignment="Center" IsEnabled="False"
                                     TextChanged="Options_TextChanged"/>
                            <TextBlock x:Name="lblCoverInfo" Grid.Column="2" Text="Leído del muro" FontSize="11" Foreground="#15803D" 
                                       VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Pie de página con botones de acción -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnCancel" Grid.Column="1" Content="Cancelar" Width="95" Height="30" Margin="0,0,8,0"
                        Background="#F8FAFC" BorderBrush="#CBD5E1" Click="BtnCancel_Click"/>
                <Button x:Name="btnApply" Grid.Column="2" Content="Armar Sardineles" Width="145" Height="30"
                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Click="BtnApply_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
